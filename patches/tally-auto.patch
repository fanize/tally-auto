+package com.example.budgetapp.database;
+
+import androidx.lifecycle.LiveData;
+import androidx.room.Dao;
+import androidx.room.Delete;
+import androidx.room.Insert;
+import androidx.room.Query;
+import androidx.room.Update;
+
+import java.util.List;
+
+/** 账本 DAO（多账本功能）。 */
+@Dao
+public interface BookDao {
+
+    @Insert
+    long insert(Book book);
+
+    @Update
+    void update(Book book);
+
+    @Delete
+    void delete(Book book);
+
+    @Query("SELECT * FROM books ORDER BY sortOrder ASC, id ASC")
+    List<Book> getAllSync();
+
+    @Query("SELECT * FROM books ORDER BY sortOrder ASC, id ASC")
+    LiveData<List<Book>> getAllLive();
+
+    @Query("SELECT * FROM books WHERE isCurrent = 1 LIMIT 1")
+    Book getCurrentSync();
+
+    @Query("SELECT * FROM books WHERE id = :id LIMIT 1")
+    Book getByIdSync(int id);
+
+    @Query("SELECT * FROM books WHERE name = :name LIMIT 1")
+    Book getByNameSync(String name);
+
+    @Query("SELECT COUNT(*) FROM books")
+    int countSync();
+
+    @Query("UPDATE books SET isCurrent = 0")
+    void clearCurrent();
+
+    @Query("UPDATE books SET isCurrent = 1 WHERE id = :id")
+    void markCurrent(int id);
+
+    @Query("DELETE FROM books WHERE id = :id")
+    void deleteById(int id);
+
+    /** 统计某账本下的账单数量（删除账本前判断用） */
+    @Query("SELECT COUNT(*) FROM transactions WHERE bookId = :bookId")
+    int countTransactions(int bookId);
+
+    /** 账单中出现过的所有账本 ID（用于恢复备份后补建缺失账本） */
+    @Query("SELECT DISTINCT bookId FROM transactions")
+    List<Integer> distinctTransactionBookIds();
+
+    /** 把账单从一个账本迁移到另一个账本（删除账本时使用） */
+    @Query("UPDATE transactions SET bookId = :toBookId WHERE bookId = :fromBookId")
+    void reassignTransactions(int fromBookId, int toBookId);
+
+    /**
+     * 触碰一条账单记录，用于让 Room 的失效追踪器通知所有账单观察者刷新。
+     *
+     * <p>切换账本时调用：账单表本身没有写入，但 UI 需要按新的“当前账本”重新查询。</p>
+     */
+    @Query("UPDATE transactions SET bookId = bookId WHERE id = (SELECT MIN(id) FROM transactions)")
+    void touchTransactions();
+}
