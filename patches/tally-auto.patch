diff --git a/app/src/main/java/com/example/budgetapp/util/BookManager.java b/app/src/main/java/com/example/budgetapp/util/BookManager.java
new file mode 100644
index 0000000..b9780c3
--- /dev/null
+++ b/app/src/main/java/com/example/budgetapp/util/BookManager.java
@@ -0,0 +1,404 @@
+package com.example.budgetapp.util;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+
+import com.example.budgetapp.database.AppDatabase;
+import com.example.budgetapp.database.Book;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * 多账本管理。
+ *
+ * <p>职责：</p>
+ * <ul>
+ *   <li>数据库中的 {@code books.isCurrent} 是“查询按哪个账本过滤”的唯一依据；</li>
+ *   <li>SharedPreferences 缓存当前账本的 id/名称，供界面直接读取（避免主线程查库）；</li>
+ *   <li>所有写操作都在后台线程执行，并在完成后回调主线程。</li>
+ * </ul>
+ */
+public class BookManager {
+
+    private static final String PREFS = "book_prefs";
+    private static final String KEY_CURRENT_ID = "current_book_id";
+    private static final String KEY_CURRENT_NAME = "current_book_name";
+
+    /** 账本变化监听（界面刷新用） */
+    private static final List<Runnable> LISTENERS = new CopyOnWriteArrayList<>();
+
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+
+    private BookManager() {
+    }
+
+    // ================= 当前账本（主线程可读） =================
+
+    public static int getCurrentBookId(Context context) {
+        return prefs(context).getInt(KEY_CURRENT_ID, Book.DEFAULT_BOOK_ID);
+    }
+
+    @NonNull
+    public static String getCurrentBookName(Context context) {
+        String name = prefs(context).getString(KEY_CURRENT_NAME, Book.DEFAULT_BOOK_NAME);
+        return TextUtils.isEmpty(name) ? Book.DEFAULT_BOOK_NAME : name;
+    }
+
+    // ================= 监听 =================
+
+    public static void addListener(Runnable listener) {
+        if (listener != null && !LISTENERS.contains(listener)) {
+            LISTENERS.add(listener);
+        }
+    }
+
+    public static void removeListener(Runnable listener) {
+        LISTENERS.remove(listener);
+    }
+
+    private static void notifyChanged() {
+        MAIN.post(() -> {
+            for (Runnable r : LISTENERS) {
+                try {
+                    r.run();
+                } catch (Exception ignored) {
+                    // 单个监听异常不影响其它界面
+                }
+            }
+        });
+    }
+
+    // ================= 异步接口 =================
+
+    public interface Callback {
+        /** @param message 供界面提示的文案；成功时可为 null */
+        void onDone(boolean ok, String message);
+    }
+
+    public interface BooksCallback {
+        void onBooks(List<Book> books);
+    }
+
+    /** 读取全部账本（后台线程查库，回调在主线程） */
+    public static void loadBooks(Context context, BooksCallback callback) {
+        final Context app = context.getApplicationContext();
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            final List<Book> books = safeList(app);
+            MAIN.post(() -> callback.onBooks(books));
+        });
+    }
+
+    /** 切换到指定账本 */
+    public static void setCurrent(Context context, Book book, Callback callback) {
+        final Context app = context.getApplicationContext();
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            boolean ok = true;
+            String message = null;
+            try {
+                AppDatabase db = AppDatabase.getDatabase(app);
+                db.bookDao().clearCurrent();
+                db.bookDao().markCurrent(book.id);
+                // 账单表未变更，但界面需要按新账本重新查询：触发一次失效通知
+                db.bookDao().touchTransactions();
+                prefs(app).edit()
+                        .putInt(KEY_CURRENT_ID, book.id)
+                        .putString(KEY_CURRENT_NAME, book.name)
+                        .apply();
+                // 桌面小组件展示当前账本数据，切换后立即刷新
+                com.example.budgetapp.widget.WidgetUtils.updateAllWidgets(app);
+            } catch (Exception e) {
+                ok = false;
+                message = "切换账本失败：" + e.getMessage();
+            }
+            final boolean fOk = ok;
+            final String fMsg = message;
+            MAIN.post(() -> {
+                if (fOk) {
+                    notifyChanged();
+                }
+                if (callback != null) {
+                    callback.onDone(fOk, fMsg);
+                }
+            });
+        });
+    }
+
+    /** 新建账本并切换过去 */
+    public static void createAndSwitch(Context context, String name, Callback callback) {
+        create(context, name, true, callback);
+    }
+
+    /** 新建账本（不切换） */
+    public static void create(Context context, String name, Callback callback) {
+        create(context, name, false, callback);
+    }
+
+    private static void create(Context context, String name, boolean switchTo, Callback callback) {
+        final Context app = context.getApplicationContext();
+        final String trimmed = name == null ? "" : name.trim();
+        if (trimmed.isEmpty()) {
+            if (callback != null) {
+                callback.onDone(false, "账本名称不能为空");
+            }
+            return;
+        }
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            boolean ok = true;
+            String message = null;
+            try {
+                AppDatabase db = AppDatabase.getDatabase(app);
+                if (db.bookDao().getByNameSync(trimmed) != null) {
+                    ok = false;
+                    message = "已存在同名账本";
+                } else {
+                    Book book = new Book(trimmed, db.bookDao().countSync());
+                    long id = db.bookDao().insert(book);
+                    if (switchTo) {
+                        db.bookDao().clearCurrent();
+                        db.bookDao().markCurrent((int) id);
+                        db.bookDao().touchTransactions();
+                        prefs(app).edit()
+                                .putInt(KEY_CURRENT_ID, (int) id)
+                                .putString(KEY_CURRENT_NAME, trimmed)
+                                .apply();
+                    }
+                }
+            } catch (Exception e) {
+                ok = false;
+                message = "新建账本失败：" + e.getMessage();
+            }
+            final boolean fOk = ok;
+            final String fMsg = message;
+            MAIN.post(() -> {
+                if (fOk) {
+                    notifyChanged();
+                }
+                if (callback != null) {
+                    callback.onDone(fOk, fMsg);
+                }
+            });
+        });
+    }
+
+    /** 重命名账本 */
+    public static void rename(Context context, Book book, String newName, Callback callback) {
+        final Context app = context.getApplicationContext();
+        final String trimmed = newName == null ? "" : newName.trim();
+        if (trimmed.isEmpty()) {
+            if (callback != null) {
+                callback.onDone(false, "账本名称不能为空");
+            }
+            return;
+        }
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            boolean ok = true;
+            String message = null;
+            try {
+                AppDatabase db = AppDatabase.getDatabase(app);
+                Book same = db.bookDao().getByNameSync(trimmed);
+                if (same != null && same.id != book.id) {
+                    ok = false;
+                    message = "已存在同名账本";
+                } else {
+                    book.name = trimmed;
+                    db.bookDao().update(book);
+                    if (getCurrentBookId(app) == book.id) {
+                        prefs(app).edit().putString(KEY_CURRENT_NAME, trimmed).apply();
+                    }
+                }
+            } catch (Exception e) {
+                ok = false;
+                message = "重命名失败：" + e.getMessage();
+            }
+            final boolean fOk = ok;
+            final String fMsg = message;
+            MAIN.post(() -> {
+                if (fOk) {
+                    notifyChanged();
+                }
+                if (callback != null) {
+                    callback.onDone(fOk, fMsg);
+                }
+            });
+        });
+    }
+
+    /**
+     * 删除账本。
+     *
+     * <p>若该账本下还有账单，会先迁移到另一个账本（优先默认账本），不会丢数据。</p>
+     */
+    public static void delete(Context context, Book book, Callback callback) {
+        final Context app = context.getApplicationContext();
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            boolean ok = true;
+            String message = null;
+            try {
+                AppDatabase db = AppDatabase.getDatabase(app);
+                List<Book> all = safeList(app);
+                if (all.size() <= 1) {
+                    ok = false;
+                    message = "至少要保留一个账本";
+                } else {
+                    // 迁移账单到另一个账本
+                    int targetId = -1;
+                    for (Book b : all) {
+                        if (b.id != book.id && b.id == Book.DEFAULT_BOOK_ID) {
+                            targetId = b.id;
+                            break;
+                        }
+                    }
+                    if (targetId == -1) {
+                        for (Book b : all) {
+                            if (b.id != book.id) {
+                                targetId = b.id;
+                                break;
+                            }
+                        }
+                    }
+                    int moved = db.bookDao().countTransactions(book.id);
+                    if (moved > 0 && targetId != -1) {
+                        db.bookDao().reassignTransactions(book.id, targetId);
+                    }
+                    // 若删的是当前账本，切换目标账本
+                    if (getCurrentBookId(app) == book.id && targetId != -1) {
+                        db.bookDao().clearCurrent();
+                        db.bookDao().markCurrent(targetId);
+                        Book target = db.bookDao().getByIdSync(targetId);
+                        if (target != null) {
+                            prefs(app).edit()
+                                    .putInt(KEY_CURRENT_ID, target.id)
+                                    .putString(KEY_CURRENT_NAME, target.name)
+                                    .apply();
+                        }
+                    }
+                    db.bookDao().deleteById(book.id);
+                    db.bookDao().touchTransactions();
+                    if (moved > 0) {
+                        message = "已删除账本，其 " + moved + " 条账单已迁移到其它账本";
+                    }
+                }
+            } catch (Exception e) {
+                ok = false;
+                message = "删除账本失败：" + e.getMessage();
+            }
+            final boolean fOk = ok;
+            final String fMsg = message;
+            MAIN.post(() -> {
+                if (fOk) {
+                    notifyChanged();
+                }
+                if (callback != null) {
+                    callback.onDone(fOk, fMsg);
+                }
+            });
+        });
+    }
+
+    /**
+     * 按名称查找账本，不存在则创建；返回账本 ID。
+     *
+     * <p><b>仅限后台线程调用</b>（会同步查库）。供外部记账接口写入指定账本使用。</p>
+     */
+    public static int ensureBookIdSync(Context context, String name) {
+        try {
+            AppDatabase db = AppDatabase.getDatabase(context);
+            String trimmed = name == null ? "" : name.trim();
+            if (trimmed.isEmpty()) {
+                Book current = db.bookDao().getCurrentSync();
+                return current != null ? current.id : Book.DEFAULT_BOOK_ID;
+            }
+            Book existing = db.bookDao().getByNameSync(trimmed);
+            if (existing != null) {
+                return existing.id;
+            }
+            Book created = new Book(trimmed, db.bookDao().countSync());
+            long id = db.bookDao().insert(created);
+            return (int) id;
+        } catch (Exception e) {
+            return Book.DEFAULT_BOOK_ID;
+        }
+    }
+
+    // ================= 内部 =================
+
+    /**
+     * 校正账本数据（<b>仅限后台线程</b>，App 启动时调用）。
+     *
+     * <p>处理三种异常情况：</p>
+     * <ol>
+     *   <li>账本表为空（异常或旧库）→ 建立默认账本；</li>
+     *   <li>没有任何“当前账本” → 取第一个账本设为当前；</li>
+     *   <li>账单指向了账本表中不存在的账本（例如恢复了其它设备的备份）→ 按原 ID 补建账本。</li>
+     * </ol>
+     */
+    public static void reconcileBooksSync(Context context) {
+        try {
+            AppDatabase db = AppDatabase.getDatabase(context);
+            List<Book> books = db.bookDao().getAllSync();
+            if (books == null || books.isEmpty()) {
+                Book def = new Book(Book.DEFAULT_BOOK_NAME, 0);
+                def.id = Book.DEFAULT_BOOK_ID;
+                def.isCurrent = true;
+                db.bookDao().insert(def);
+                prefs(context).edit()
+                        .putInt(KEY_CURRENT_ID, def.id)
+                        .putString(KEY_CURRENT_NAME, def.name)
+                        .apply();
+            }
+
+            Book current = db.bookDao().getCurrentSync();
+            if (current == null) {
+                List<Book> all = db.bookDao().getAllSync();
+                if (all != null && !all.isEmpty()) {
+                    Book first = all.get(0);
+                    db.bookDao().clearCurrent();
+                    db.bookDao().markCurrent(first.id);
+                    current = first;
+                }
+            }
+            if (current != null) {
+                prefs(context).edit()
+                        .putInt(KEY_CURRENT_ID, current.id)
+                        .putString(KEY_CURRENT_NAME, current.name)
+                        .apply();
+            }
+
+            List<Integer> usedIds = db.bookDao().distinctTransactionBookIds();
+            if (usedIds != null) {
+                for (Integer id : usedIds) {
+                    if (id == null || id <= 0) {
+                        continue;
+                    }
+                    if (db.bookDao().getByIdSync(id) == null) {
+                        Book orphan = new Book("账本 " + id, db.bookDao().countSync());
+                        orphan.id = id;
+                        db.bookDao().insert(orphan);
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+            // 校正失败不影响正常使用
+        }
+    }
+
+    private static List<Book> safeList(Context context) {
+        try {
+            List<Book> list = AppDatabase.getDatabase(context).bookDao().getAllSync();
+            return list != null ? list : new ArrayList<>();
+        } catch (Exception e) {
+            return new ArrayList<>();
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
