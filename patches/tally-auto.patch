@@ -0,0 +1,194 @@
+package com.example.budgetapp.api;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.example.budgetapp.database.AppDatabase;
+import com.example.budgetapp.database.AssetAccount;
+import com.example.budgetapp.database.Book;
+import com.example.budgetapp.util.CategoryManager;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.List;
+
+/**
+ * 供自动化工具（AutoAccounting）读取 Tally 数据的只读接口。
+ *
+ * <p>用途：把 Tally 里的<b>账本 / 账户 / 分类</b>导出给 AA，让 AA 的“资产映射、分类映射、
+ * 账本选择”开箱即用（对应 AA 适配器的 {@code syncAssets()}）。</p>
+ *
+ * <p>安全：Provider 虽然 exported，但只允许调用方包名为 {@code net.ankio.auto}
+ * （通过 {@link #getCallingPackage()} 校验），其它应用一律拒绝；且只读、不提供写入。</p>
+ *
+ * <p>用法：{@code content://com.example.budgetapp.sync/export}，返回单列 {@code json} 的游标。</p>
+ */
+public class TallySyncProvider extends ContentProvider {
+
+    public static final String AUTHORITY = "com.example.budgetapp.sync";
+    /** 允许读取数据的调用方包名 */
+    public static final String ALLOWED_CALLER = "net.ankio.auto";
+    /** 导出数据版本，AA 侧据此兼容 */
+    public static final int EXPORT_VERSION = 1;
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Nullable
+    @Override
+    public Cursor query(@NonNull Uri uri, @Nullable String[] projection, @Nullable String selection,
+                        @Nullable String[] selectionArgs, @Nullable String sortOrder) {
+        // 仅允许 AA 读取；其它应用（含 shell/root）一律拒绝
+        String caller = getCallingPackage();
+        if (!ALLOWED_CALLER.equals(caller)) {
+            android.util.Log.i("TallySync", "rejected caller=" + caller);
+            return null;
+        }
+        Context context = getContext();
+        if (context == null) {
+            return null;
+        }
+        MatrixCursor cursor = new MatrixCursor(new String[]{"json"});
+        try {
+            String json = buildExportJson(context);
+            android.util.Log.i("TallySync", "served caller=" + caller + " bytes=" + json.length());
+            cursor.addRow(new Object[]{json});
+        } catch (Exception e) {
+            android.util.Log.e("TallySync", "export failed: " + e.getMessage());
+            // 返回空游标，AA 侧会记录同步失败
+            return cursor;
+        }
+        return cursor;
+    }
+
+    /** 组装导出 JSON */
+    private String buildExportJson(Context context) throws Exception {
+        AppDatabase db = AppDatabase.getDatabase(context);
+        JSONObject root = new JSONObject();
+        root.put("version", EXPORT_VERSION);
+        root.put("generatedAt", System.currentTimeMillis());
+
+        // 账本
+        JSONArray books = new JSONArray();
+        List<Book> bookList = db.bookDao().getAllSync();
+        if (bookList != null) {
+            for (Book b : bookList) {
+                if (b == null || TextUtils.isEmpty(b.name)) {
+                    continue;
+                }
+                JSONObject o = new JSONObject();
+                o.put("id", b.id);
+                o.put("name", b.name);
+                o.put("isCurrent", b.isCurrent);
+                o.put("sort", b.sortOrder);
+                books.put(o);
+            }
+        }
+        root.put("books", books);
+
+        // 账户（资产）
+        JSONArray assets = new JSONArray();
+        List<AssetAccount> assetList = db.assetAccountDao().getAllAssetsSync();
+        if (assetList != null) {
+            for (AssetAccount a : assetList) {
+                if (a == null || TextUtils.isEmpty(a.name)) {
+                    continue;
+                }
+                JSONObject o = new JSONObject();
+                o.put("id", a.id);
+                o.put("name", a.name);
+                o.put("type", a.type);
+                o.put("amount", a.amount);
+                o.put("currencySymbol", a.currencySymbol == null ? "¥" : a.currencySymbol);
+                o.put("assetCategory", a.assetCategory == null ? "" : a.assetCategory);
+                assets.put(o);
+            }
+        }
+        root.put("assets", assets);
+
+        // 分类（Tally 分类为全局设置，存于 SharedPreferences）
+        JSONObject categories = new JSONObject();
+        JSONArray expense = new JSONArray();
+        for (String c : CategoryManager.getExpenseCategories(context)) {
+            if (!TextUtils.isEmpty(c)) {
+                expense.put(c);
+            }
+        }
+        JSONArray income = new JSONArray();
+        for (String c : CategoryManager.getIncomeCategories(context)) {
+            if (!TextUtils.isEmpty(c)) {
+                income.put(c);
+            }
+        }
+        JSONObject subMap = new JSONObject();
+        for (String parent : CategoryManager.getExpenseCategories(context)) {
+            List<String> subs = CategoryManager.getSubCategories(context, parent);
+            if (subs != null && !subs.isEmpty()) {
+                JSONArray arr = new JSONArray();
+                for (String s : subs) {
+                    if (!TextUtils.isEmpty(s)) {
+                        arr.put(s);
+                    }
+                }
+                if (arr.length() > 0) {
+                    subMap.put(parent, arr);
+                }
+            }
+        }
+        for (String parent : CategoryManager.getIncomeCategories(context)) {
+            List<String> subs = CategoryManager.getSubCategories(context, parent);
+            if (subs != null && !subs.isEmpty()) {
+                JSONArray arr = new JSONArray();
+                for (String s : subs) {
+                    if (!TextUtils.isEmpty(s)) {
+                        arr.put(s);
+                    }
+                }
+                if (arr.length() > 0) {
+                    subMap.put(parent, arr);
+                }
+            }
+        }
+        categories.put("expense", expense);
+        categories.put("income", income);
+        categories.put("subCategories", subMap);
+        root.put("categories", categories);
+
+        return root.toString();
+    }
+
+    @Nullable
+    @Override
+    public String getType(@NonNull Uri uri) {
+        return "vnd.android.cursor.item/vnd.budgetapp.sync";
+    }
+
+    @Nullable
+    @Override
+    public Uri insert(@NonNull Uri uri, @Nullable ContentValues values) {
+        // 只读接口
+        return null;
+    }
+
+    @Override
+    public int delete(@NonNull Uri uri, @Nullable String selection, @Nullable String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public int update(@NonNull Uri uri, @Nullable ContentValues values, @Nullable String selection,
+                      @Nullable String[] selectionArgs) {
+        return 0;
+    }
+}
