new file mode 100644
index 0000000..8e9270d
--- /dev/null
+++ b/app/src/main/java/com/example/budgetapp/ui/BookDialogs.java
@@ -0,0 +1,187 @@
+package com.example.budgetapp.ui;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.text.InputType;
+import android.view.inputmethod.EditorInfo;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import com.example.budgetapp.database.Book;
+import com.example.budgetapp.util.BookManager;
+
+import java.util.List;
+
+/**
+ * 多账本相关对话框：切换、新建、重命名、删除。
+ *
+ * <p>用法（在账单页点击顶部“当前账本”即可打开）：</p>
+ * <pre>
+ * BookDialogs.showBookPicker(context, () -&gt; { /* 账本变化后的界面刷新 *\/ });
+ * </pre>
+ */
+public final class BookDialogs {
+
+    private BookDialogs() {
+    }
+
+    /** 账本选择器：点击切换，长按重命名/删除 */
+    public static void showBookPicker(Context context, Runnable onChanged) {
+        final Context appContext = context.getApplicationContext();
+        BookManager.loadBooks(context, books -> {
+            if (books == null || books.isEmpty()) {
+                Toast.makeText(appContext, "账本读取失败", Toast.LENGTH_SHORT).show();
+                return;
+            }
+            final int currentId = BookManager.getCurrentBookId(context);
+            final String[] items = new String[books.size() + 1];
+            for (int i = 0; i < books.size(); i++) {
+                Book b = books.get(i);
+                items[i] = (b.id == currentId ? "✓ " : "") + b.name;
+            }
+            items[books.size()] = "＋ 新建账本…";
+
+            AlertDialog dialog = new AlertDialog.Builder(context)
+                    .setTitle("选择账本")
+                    .setItems(items, (d, which) -> {
+                        if (which == books.size()) {
+                            showCreateDialog(context, true, onChanged);
+                        } else {
+                            Book target = books.get(which);
+                            if (target.id == currentId) {
+                                return;
+                            }
+                            BookManager.setCurrent(context, target, (ok, message) -> {
+                                if (message != null) {
+                                    Toast.makeText(appContext, message, Toast.LENGTH_SHORT).show();
+                                }
+                                if (ok && onChanged != null) {
+                                    onChanged.run();
+                                }
+                            });
+                        }
+                    })
+                    .setNegativeButton("取消", null)
+                    .create();
+            dialog.show();
+
+            // 长按：管理该账本
+            if (dialog.getListView() != null) {
+                dialog.getListView().setOnItemLongClickListener((parent, view, position, id) -> {
+                    if (position >= books.size()) {
+                        return false;
+                    }
+                    showManageDialog(context, books.get(position), onChanged);
+                    dialog.dismiss();
+                    return true;
+                });
+            }
+        });
+    }
+
+    /** 单个账本的管理：重命名 / 删除 */
+    public static void showManageDialog(Context context, Book book, Runnable onChanged) {
+        String[] options = {"重命名", "删除"};
+        new AlertDialog.Builder(context)
+                .setTitle(book.name)
+                .setItems(options, (d, which) -> {
+                    if (which == 0) {
+                        showRenameDialog(context, book, onChanged);
+                    } else {
+                        confirmDelete(context, book, onChanged);
+                    }
+                })
+                .setNegativeButton("取消", null)
+                .show();
+    }
+
+    /** 新建账本 */
+    public static void showCreateDialog(Context context, boolean switchTo, Runnable onChanged) {
+        final Context appContext = context.getApplicationContext();
+        EditText input = buildInput(context, "");
+        new AlertDialog.Builder(context)
+                .setTitle("新建账本")
+                .setView(input)
+                .setPositiveButton("创建", (d, w) -> BookManager.create(context, input.getText().toString(),
+                        (ok, message) -> {
+                            if (!ok) {
+                                Toast.makeText(appContext, message == null ? "创建失败" : message, Toast.LENGTH_SHORT).show();
+                            } else if (switchTo) {
+                                // 创建后立即切换
+                                BookManager.loadBooks(context, books -> {
+                                    String name = input.getText().toString().trim();
+                                    for (Book b : books) {
+                                        if (b.name.equals(name)) {
+                                            BookManager.setCurrent(context, b, (ok2, msg2) -> {
+                                                if (msg2 != null) {
+                                                    Toast.makeText(appContext, msg2, Toast.LENGTH_SHORT).show();
+                                                }
+                                                if (ok2 && onChanged != null) {
+                                                    onChanged.run();
+                                                }
+                                            });
+                                            break;
+                                        }
+                                    }
+                                });
+                            } else if (onChanged != null) {
+                                onChanged.run();
+                            }
+                        }))
+                .setNegativeButton("取消", null)
+                .show();
+    }
+
+    /** 重命名账本 */
+    public static void showRenameDialog(Context context, Book book, Runnable onChanged) {
+        final Context appContext = context.getApplicationContext();
+        EditText input = buildInput(context, book.name);
+        new AlertDialog.Builder(context)
+                .setTitle("重命名账本")
+                .setView(input)
+                .setPositiveButton("保存", (d, w) -> BookManager.rename(context, book, input.getText().toString(),
+                        (ok, message) -> {
+                            if (message != null) {
+                                Toast.makeText(appContext, message, Toast.LENGTH_SHORT).show();
+                            }
+                            if (ok && onChanged != null) {
+                                onChanged.run();
+                            }
+                        }))
+                .setNegativeButton("取消", null)
+                .show();
+    }
+
+    /** 删除账本确认 */
+    public static void confirmDelete(Context context, Book book, Runnable onChanged) {
+        final Context appContext = context.getApplicationContext();
+        new AlertDialog.Builder(context)
+                .setTitle("删除账本")
+                .setMessage("确定删除「" + book.name + "」吗？\n该账本下的账单会自动迁移到其它账本，不会丢失。")
+                .setPositiveButton("删除", (d, w) -> BookManager.delete(context, book, (ok, message) -> {
+                    if (message != null) {
+                        Toast.makeText(appContext, message, Toast.LENGTH_SHORT).show();
+                    }
+                    if (ok && onChanged != null) {
+                        onChanged.run();
+                    }
+                }))
+                .setNegativeButton("取消", null)
+                .show();
+    }
+
+    private static EditText buildInput(Context context, String initial) {
+        EditText input = new EditText(context);
+        input.setInputType(InputType.TYPE_CLASS_TEXT);
+        input.setSingleLine(true);
+        input.setImeOptions(EditorInfo.IME_ACTION_DONE);
+        input.setHint("账本名称");
+        if (initial != null && !initial.isEmpty()) {
+            input.setText(initial);
+            input.setSelection(initial.length());
+        }
+        int pad = (int) (context.getResources().getDisplayMetrics().density * 20);
+        input.setPadding(pad, pad, pad, pad);
+        return input;
+    }
+}
