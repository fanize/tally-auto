@@ -0,0 +1,50 @@
+package com.example.budgetapp.database;
+
+import androidx.annotation.NonNull;
+import androidx.room.ColumnInfo;
+import androidx.room.Entity;
+import androidx.room.Index;
+import androidx.room.PrimaryKey;
+
+/**
+ * 账本（多账本功能）。
+ *
+ * <p>账单通过 {@link Transaction#bookId} 归属到某个账本；同一时刻只有一个账本的
+ * {@link #isCurrent} 为 1，UI 查询统一按“当前账本”过滤。</p>
+ */
+@Entity(tableName = "books",
+        indices = {@Index(value = "name", unique = true)})
+public class Book {
+
+    /** 默认账本 ID（迁移与恢复时的兜底账本） */
+    public static final int DEFAULT_BOOK_ID = 1;
+    /** 默认账本名称（与 AA 侧 BillInfoModel.DEFAULT_BOOK_NAME 保持一致） */
+    public static final String DEFAULT_BOOK_NAME = "默认账本";
+
+    @PrimaryKey(autoGenerate = true)
+    public int id;
+
+    @NonNull
+    public String name = "";
+
+    /** 创建时间（毫秒） */
+    public long createdAt;
+
+    /** 排序序号，越小越靠前 */
+    public int sortOrder;
+
+    /** 是否为当前账本（1 是，0 否） */
+    @ColumnInfo(defaultValue = "0")
+    public boolean isCurrent;
+
+    public Book() {
+    }
+
+    @androidx.room.Ignore
+    public Book(@NonNull String name, int sortOrder) {
+        this.name = name;
+        this.sortOrder = sortOrder;
+        this.createdAt = System.currentTimeMillis();
+        this.isCurrent = false;
+    }
+}
