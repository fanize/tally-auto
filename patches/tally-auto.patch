--- /dev/null
+++ b/app/src/main/java/com/example/budgetapp/api/TallyApi.java
@@ -0,0 +1,310 @@
+package com.example.budgetapp.api;
+
+import android.net.Uri;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * Tally 外部记账接口（Automation API）——参数模型与解析。
+ *
+ * <p>协议：{@code tally://publicapi/addbill?...}，供 AutoAccounting 等自动化工具调用。
+ * 设计原则：<b>宽容解析</b>——未知参数忽略，缺失参数用默认值，解析失败给出可读原因。</p>
+ *
+ * <p>示例：</p>
+ * <pre>
+ * tally://publicapi/addbill?type=0&amp;money=26.5&amp;time=2026-09-22 12:30:00
+ *   &amp;remark=午餐&amp;catename=餐饮&amp;subcategory=午饭
+ *   &amp;accountname=微信&amp;currency=CNY&amp;tag=出差&amp;flag=0&amp;id=12345&amp;showresult=0
+ * </pre>
+ *
+ * <p>参数说明：</p>
+ * <ul>
+ *   <li>{@code type} 0支出 1收入 2转账 3负债(借入) 4借出</li>
+ *   <li>{@code money} 金额（正数，必填）</li>
+ *   <li>{@code fee} 手续费(&lt;0) 或 优惠(&gt;0)，可空</li>
+ *   <li>{@code time} {@code yyyy-MM-dd HH:mm:ss} 或 毫秒时间戳，可空（默认当前时间）</li>
+ *   <li>{@code remark} 备注；{@code catename} 分类；{@code subcategory} 二级分类</li>
+ *   <li>{@code accountname} 账户（转出账户）；{@code accountname2} 转入账户</li>
+ *   <li>{@code bookname} 账本名（多账本功能启用后生效，当前版本仅接收）</li>
+ *   <li>{@code currency} 币种代码，如 CNY/USD；{@code tag} 标签（逗号分隔）</li>
+ *   <li>{@code flag} 1=不计入统计 2=不计入预算（可组合）</li>
+ *   <li>{@code id} 调用方的账单唯一 ID（用于去重）</li>
+ *   <li>{@code showresult} 0=不弹提示；其余=弹提示</li>
+ * </ul>
+ */
+public final class TallyApi {
+
+    public static final String SCHEME = "tally";
+    public static final String HOST = "publicapi";
+    public static final String PATH_ADD_BILL = "/addbill";
+
+    /** 账本名占位（多账本功能尚未启用时使用） */
+    public static final String DEFAULT_BOOK_NAME = "默认账本";
+
+    // ===== Tally 内部账单类型 =====
+    public static final int TYPE_EXPENSE = 0;   // 支出
+    public static final int TYPE_INCOME = 1;    // 收入
+    public static final int TYPE_TRANSFER = 2;  // 资产互转
+    public static final int TYPE_LIABILITY = 3; // 负债（借入）
+    public static final int TYPE_LEND = 4;      // 借出
+
+    // ===== 标志位（与 AA 的 BillInfoModel 对齐） =====
+    public static final int FLAG_NOT_COUNT = 1;
+    public static final int FLAG_NOT_BUDGET = 2;
+
+    private TallyApi() {
+    }
+
+    /** 解析后的账单数据。 */
+    public static final class Bill {
+        public int type = TYPE_EXPENSE;
+        public double amount = 0d;
+        public double fee = 0d;
+        public long time = 0L;
+        public String remark = "";
+        public String category = "";
+        public String subCategory = "";
+        public String accountNameFrom = "";
+        public String accountNameTo = "";
+        public String bookName = DEFAULT_BOOK_NAME;
+        public String currencyCode = "CNY";
+        public String tags = "";
+        public int flag = 0;
+        public String extId = "";
+        public String extendData = "";
+        public String app = "";
+        public boolean showResult = true;
+
+        /** 是否为转账（需要两个账户） */
+        public boolean isTransfer() {
+            return type == TYPE_TRANSFER;
+        }
+
+        /** 是否需要“对方对象”（负债/借出） */
+        public boolean needsTargetObject() {
+            return type == TYPE_LIABILITY || type == TYPE_LEND;
+        }
+
+        public boolean isExcludedFromBudget() {
+            return (flag & (FLAG_NOT_COUNT | FLAG_NOT_BUDGET)) != 0;
+        }
+    }
+
+    /** 解析异常：参数非法。 */
+    public static class ParseException extends Exception {
+        public ParseException(String message) {
+            super(message);
+        }
+    }
+
+    /**
+     * 将 URI 解析为账单对象。解析失败抛出 {@link ParseException}（带可读原因）。
+     */
+    public static Bill parse(Uri uri) throws ParseException {
+        if (uri == null) {
+            throw new ParseException("uri 为空");
+        }
+        Bill bill = new Bill();
+
+        String typeStr = uri.getQueryParameter("type");
+        if (typeStr == null || typeStr.trim().isEmpty()) {
+            throw new ParseException("缺少 type");
+        }
+        int type;
+        try {
+            type = Integer.parseInt(typeStr.trim());
+        } catch (NumberFormatException e) {
+            throw new ParseException("type 非法: " + typeStr);
+        }
+        if (type < 0 || type > 4) {
+            throw new ParseException("不支持的 type: " + type);
+        }
+        bill.type = type;
+
+        String moneyStr = uri.getQueryParameter("money");
+        if (moneyStr == null || moneyStr.trim().isEmpty()) {
+            throw new ParseException("缺少 money");
+        }
+        double money;
+        try {
+            money = Double.parseDouble(moneyStr.trim());
+        } catch (NumberFormatException e) {
+            throw new ParseException("money 非法: " + moneyStr);
+        }
+        if (money <= 0) {
+            throw new ParseException("money 必须大于 0");
+        }
+        bill.amount = money;
+
+        bill.fee = optDouble(uri, "fee", 0d);
+        bill.time = optTime(uri.getQueryParameter("time"));
+
+        bill.remark = optString(uri, "remark");
+        bill.category = optString(uri, "catename");
+        if (bill.category.isEmpty()) {
+            // 兼容其它调用方写法
+            bill.category = optString(uri, "category");
+        }
+        bill.subCategory = optString(uri, "subcategory");
+        if (bill.subCategory.isEmpty()) {
+            bill.subCategory = optString(uri, "subcatename");
+        }
+        bill.accountNameFrom = optString(uri, "accountname");
+        bill.accountNameTo = optString(uri, "accountname2");
+
+        String book = optString(uri, "bookname");
+        if (!book.isEmpty()) {
+            bill.bookName = book;
+        }
+
+        String currency = optString(uri, "currency");
+        if (!currency.isEmpty()) {
+            bill.currencyCode = normalizeCurrencyCode(currency);
+        }
+
+        bill.tags = optString(uri, "tag");
+        if (bill.tags.isEmpty()) {
+            bill.tags = optString(uri, "tags");
+        }
+        bill.flag = (int) optDouble(uri, "flag", 0d);
+        bill.extId = optString(uri, "id");
+        bill.extendData = optString(uri, "extenddata");
+        bill.app = optString(uri, "app");
+
+        String showResult = optString(uri, "showresult");
+        bill.showResult = showResult.isEmpty() || !"0".equals(showResult);
+
+        // 转账 / 负债 / 借出 必须有第二个账户名
+        if (bill.isTransfer() && bill.accountNameTo.isEmpty()) {
+            throw new ParseException("转账缺少 accountname2");
+        }
+        if (bill.needsTargetObject()
+                && bill.accountNameTo.isEmpty()
+                && bill.accountNameFrom.isEmpty()) {
+            throw new ParseException("负债/借出缺少 accountname2（对方对象）");
+        }
+        return bill;
+    }
+
+    /** 币种代码 → 显示符号。Tally 目前只存符号，未知币种回退 ¥。 */
+    public static String currencySymbolOf(String code) {
+        String c = normalizeCurrencyCode(code);
+        switch (c) {
+            case "CNY":
+            case "RMB":
+                return "¥";
+            case "USD":
+                return "$";
+            case "EUR":
+                return "€";
+            case "GBP":
+                return "£";
+            case "JPY":
+                return "JP¥";
+            case "KRW":
+                return "₩";
+            case "HKD":
+                return "HK$";
+            case "TWD":
+                return "NT$";
+            case "SGD":
+                return "S$";
+            case "AUD":
+                return "A$";
+            case "CAD":
+                return "C$";
+            case "RUB":
+                return "₽";
+            case "THB":
+                return "฿";
+            case "INR":
+                return "₹";
+            default:
+                return "¥";
+        }
+    }
+
+    /** 归一化币种代码：兼容 AA 传入的 JSON（{"code":"USD",...}）或纯代码。 */
+    public static String normalizeCurrencyCode(String raw) {
+        if (raw == null) {
+            return "CNY";
+        }
+        String value = raw.trim();
+        if (value.isEmpty()) {
+            return "CNY";
+        }
+        if (value.startsWith("{")) {
+            // 简易提取 "code":"XXX"，避免引入 JSON 依赖
+            int idx = value.indexOf("\"code\"");
+            if (idx >= 0) {
+                int colon = value.indexOf(':', idx);
+                int firstQuote = value.indexOf('"', colon + 1);
+                int secondQuote = firstQuote >= 0 ? value.indexOf('"', firstQuote + 1) : -1;
+                if (firstQuote >= 0 && secondQuote > firstQuote) {
+                    value = value.substring(firstQuote + 1, secondQuote);
+                }
+            }
+        }
+        return value.trim().toUpperCase(Locale.ROOT);
+    }
+
+    /** 拆分分类：AA 用 "-" 连接父/子分类；若调用方直接给了 subcategory 则优先用它。 */
+    public static String[] splitCategory(String category, String subCategory) {
+        String parent = category == null ? "" : category.trim();
+        String child = subCategory == null ? "" : subCategory.trim();
+        int dash = parent.indexOf('-');
+        if (dash > 0 && child.isEmpty()) {
+            child = parent.substring(dash + 1).trim();
+            parent = parent.substring(0, dash).trim();
+        }
+        return new String[]{parent, child};
+    }
+
+    private static String optString(Uri uri, String key) {
+        String v = uri.getQueryParameter(key);
+        return v == null ? "" : v.trim();
+    }
+
+    private static double optDouble(Uri uri, String key, double def) {
+        String v = uri.getQueryParameter(key);
+        if (v == null || v.trim().isEmpty()) {
+            return def;
+        }
+        try {
+            return Double.parseDouble(v.trim());
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+
+    /** 时间参数：支持 "yyyy-MM-dd HH:mm:ss" 与毫秒时间戳；非法或缺失返回 0。 */
+    private static long optTime(String raw) {
+        if (raw == null || raw.trim().isEmpty()) {
+            return 0L;
+        }
+        String v = raw.trim();
+        if (v.matches("\\d{10,}")) {
+            try {
+                long ts = Long.parseLong(v);
+                // 10 位按秒处理
+                return v.length() <= 10 ? ts * 1000L : ts;
+            } catch (NumberFormatException ignored) {
+                // fallthrough
+            }
+        }
+        String[] patterns = {"yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm", "yyyy-MM-dd", "yyyy/MM/dd HH:mm:ss"};
+        for (String p : patterns) {
+            try {
+                Date d = new SimpleDateFormat(p, Locale.CHINA).parse(v);
+                if (d != null) {
+                    return d.getTime();
+                }
+            } catch (Exception ignored) {
+                // 尝试下一个格式
+            }
+        }
+        return 0L;
+    }
+}
