@@ -0,0 +1,396 @@
+package com.example.budgetapp.api;
+
+import android.app.Application;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+
+import androidx.core.app.NotificationCompat;
+
+import com.example.budgetapp.BackupManager;
+import com.example.budgetapp.R;
+import com.example.budgetapp.database.AppDatabase;
+import com.example.budgetapp.database.AssetAccount;
+import com.example.budgetapp.database.Transaction;
+import com.example.budgetapp.util.CategoryManager;
+import com.example.budgetapp.viewmodel.FinanceViewModel;
+
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * 外部记账接口的“写库器”。
+ *
+ * <p>复用 App 自身的写入通道，保证与手动记账行为一致：</p>
+ * <ul>
+ *   <li>支出/收入/负债/借出 → {@link FinanceViewModel#addTransactionWithAssetSync(Transaction)}</li>
+ *   <li>转账（资产互转）→ 与 {@code FinanceViewModel.transferAsset} 相同的双边余额规则</li>
+ * </ul>
+ *
+ * <p>幂等：优先用调用方传入的账单 ID 去重；没有 ID 时按“同类型同金额、时间相近”兜底去重。</p>
+ */
+public final class TallyApiWriter {
+
+    /** 写入结果回调（主线程）。 */
+    public interface Callback {
+        void onResult(boolean ok, boolean duplicated, String message);
+    }
+
+    private static final String PREFS = "tally_api_prefs";
+    private static final String KEY_IDS = "written_ext_ids";
+    private static final int MAX_IDS = 500;
+
+    /** 兜底去重的时间窗口（毫秒） */
+    private static final long FALLBACK_WINDOW_MS = 120_000L;
+
+    /** 通知渠道 ID */
+    private static final String CHANNEL_ID = "tally_auto_record";
+    /** 通知 ID 自增器（避免覆盖前一条） */
+    private static final AtomicInteger NOTIFICATION_ID = new AtomicInteger(1000);
+
+    private TallyApiWriter() {
+    }
+
+    public static void write(final Context context, final TallyApi.Bill bill, final Callback callback) {
+        final Context app = context.getApplicationContext();
+        AppDatabase.databaseWriteExecutor.execute(() -> {
+            boolean ok = false;
+            boolean duplicated = false;
+            String message;
+            try {
+                duplicated = doWrite(app, bill);
+                ok = true;
+                message = duplicated ? "重复账单，已忽略" : "已记账";
+            } catch (Exception e) {
+                ok = false;
+                message = "写入失败：" + e.getMessage();
+            }
+            final boolean fOk = ok;
+            final boolean fDup = duplicated;
+            final String fMsg = message;
+            // 结果通过系统通知告知用户（不再弹界面/Toast）
+            if (fOk && !fDup) {
+                String typeLabel = bill.type == 1 ? "收入" : bill.type == 2 ? "转账" : "支出";
+                String title = "✅ " + typeLabel + " " + trimNumber(bill.amount);
+                String text = TextUtils.isEmpty(bill.remark) ? bill.category : bill.remark;
+                postNotification(app, title, text);
+            } else if (!fOk) {
+                postNotification(app, "❌ Tally 记账失败", fMsg);
+            }
+            if (callback != null) {
+                new Handler(Looper.getMainLooper()).post(() -> callback.onResult(fOk, fDup, fMsg));
+            }
+        });
+    }
+
+    /** 发送系统通知（记账成功/失败） */
+    public static void postNotification(Context context, String title, String text) {
+        try {
+            NotificationManager nm = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+            if (nm == null) return;
+            // Android 8+ 需要通知渠道
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                NotificationChannel channel = new NotificationChannel(CHANNEL_ID,
+                        "自动记账", NotificationManager.IMPORTANCE_DEFAULT);
+                channel.setDescription("外部自动记账结果通知");
+                nm.createNotificationChannel(channel);
+            }
+            NotificationCompat.Builder builder = new NotificationCompat.Builder(context, CHANNEL_ID)
+                    .setSmallIcon(R.drawable.ic_app_logo)
+                    .setContentTitle(title)
+                    .setContentText(text)
+                    .setAutoCancel(true)
+                    .setPriority(NotificationCompat.PRIORITY_DEFAULT);
+            nm.notify(NOTIFICATION_ID.incrementAndGet(), builder.build());
+        } catch (Exception ignored) {
+            // 通知失败不影响记账
+        }
+    }
+
+    /**
+     * 执行写入。返回 true 表示判定为重复账单（未写入）。
+     */
+    private static boolean doWrite(Context app, TallyApi.Bill bill) throws Exception {
+        AppDatabase db = AppDatabase.getDatabase(app);
+
+        if (isDuplicated(app, db, bill)) {
+            return true;
+        }
+
+        // ===== 1. 金额与备注加工（手续费/优惠、标签留痕） =====
+        double amount = bill.amount;
+        StringBuilder remark = new StringBuilder(bill.remark == null ? "" : bill.remark.trim());
+        if (bill.fee < 0) {
+            // AA 约定：fee < 0 为手续费，总额 = money + |fee|
+            double feeValue = -bill.fee;
+            amount = bill.amount + feeValue;
+        } else if (bill.fee > 0) {
+            // fee > 0 为优惠：实扣金额 = money - 优惠
+            amount = bill.amount - bill.fee;
+            if (amount <= 0) {
+                amount = bill.amount;
+            }
+        }
+        if (!TextUtils.isEmpty(bill.tags)) {
+            // 标签存独立字段（二期），不再拼进备注
+        }
+
+        // ===== 2. 分类 =====
+        String[] cate = TallyApi.splitCategory(bill.category, bill.subCategory);
+        String category = cate[0];
+        String subCategory = cate[1];
+        if (bill.type == TallyApi.TYPE_LIABILITY) {
+            category = "负债";
+            subCategory = "";
+        } else if (bill.type == TallyApi.TYPE_LEND) {
+            category = "借出";
+            subCategory = "";
+        } else if (bill.type != TallyApi.TYPE_TRANSFER) {
+            if (category.isEmpty()) {
+                category = "其他";
+            }
+            ensureCategoryExists(app, bill.type, category);
+        }
+
+        long date = bill.time > 0 ? bill.time : System.currentTimeMillis();
+        String note = new SimpleDateFormat("MM-dd HH:mm", Locale.CHINA).format(new java.util.Date(date));
+
+        // ===== 2.5 账本（多账本：AA 指定账本名则写入对应账本，否则归入当前账本）=====
+        int bookId = 0; // 0 = 交给数据库触发器归入“当前账本”
+        if (!TextUtils.isEmpty(bill.bookName)
+                && !com.example.budgetapp.database.Book.DEFAULT_BOOK_NAME.equals(bill.bookName.trim())) {
+            bookId = com.example.budgetapp.util.BookManager.ensureBookIdSync(app, bill.bookName);
+        }
+
+        // ===== 3. 账户 =====
+        int fromAssetId = resolveAssetId(db, bill.accountNameFrom);
+        if (bill.type == TallyApi.TYPE_TRANSFER) {
+            int toAssetId = resolveAssetId(db, bill.accountNameTo);
+            if (fromAssetId == 0 || toAssetId == 0 || fromAssetId == toAssetId) {
+                throw new IllegalArgumentException("转账需要两个不同的有效账户");
+            }
+            writeTransfer(app, db, bill, fromAssetId, toAssetId, amount, date, remark.toString(), bookId);
+            markWritten(app, bill.extId);
+            return false;
+        }
+
+        // ===== 4. 组装账单 =====
+        Transaction t = new Transaction();
+        t.date = date;
+        t.type = bill.type;
+        t.amount = amount;
+        t.category = category;
+        t.subCategory = subCategory;
+        t.assetId = fromAssetId;
+        t.bookId = bookId;
+        t.currencySymbol = TallyApi.currencySymbolOf(bill.currencyCode);
+        t.currencyCode = TallyApi.normalizeCurrencyCode(bill.currencyCode);
+        t.tags = bill.tags == null ? "" : bill.tags.trim();
+        t.fee = bill.fee;
+        t.photoPath = "";
+        t.excludeFromBudget = bill.isExcludedFromBudget();
+        t.remark = remark.toString();
+
+        if (bill.needsTargetObject()) {
+            // 负债(借入)/借出：对方对象写入 targetObject，Tally 会自动维护对应资产账户
+            String target = !TextUtils.isEmpty(bill.accountNameTo) ? bill.accountNameTo : bill.accountNameFrom;
+            t.targetObject = target;
+            t.note = note;
+        } else if (!TextUtils.isEmpty(bill.accountNameTo)) {
+            // 支出还款 / 收入收款：Tally 依据 note 匹配负债/借出账户名
+            t.note = bill.accountNameTo;
+        } else {
+            t.note = note;
+        }
+
+        // ===== 5. 走 App 自身的写入通道（含资产联动、自动上传、小组件刷新） =====
+        FinanceViewModel viewModel = new FinanceViewModel((Application) app);
+        viewModel.addTransactionWithAssetSync(t);
+
+        markWritten(app, bill.extId);
+        return false;
+    }
+
+    /**
+     * 转账：与 FinanceViewModel#transferAsset 的“同币种”分支保持一致的双边余额规则。
+     */
+    private static void writeTransfer(Context app, AppDatabase db, TallyApi.Bill bill,
+                                      int fromAssetId, int toAssetId, double amount, long date,
+                                      String remark, int bookId) {
+        AssetAccount from = db.assetAccountDao().getAssetByIdSync(fromAssetId);
+        AssetAccount to = db.assetAccountDao().getAssetByIdSync(toAssetId);
+        if (from == null || to == null) {
+            throw new IllegalArgumentException("账户不存在");
+        }
+        db.runInTransaction(() -> {
+            // 转出：负债账户增加负债，其余减少余额
+            if (from.type == 1) {
+                from.amount += amount;
+            } else {
+                from.amount -= amount;
+            }
+            // 转入：负债账户抵扣负债，其余增加余额
+            if (to.type == 1) {
+                to.amount -= amount;
+            } else {
+                to.amount += amount;
+            }
+            long now = System.currentTimeMillis();
+            from.updateTime = now;
+            to.updateTime = now;
+            db.assetAccountDao().update(from);
+            db.assetAccountDao().update(to);
+
+            Transaction t = new Transaction();
+            t.date = date;
+            t.type = TallyApi.TYPE_TRANSFER;
+            t.category = "资产互转";
+            t.subCategory = "";
+            t.amount = amount;
+            t.assetId = from.id;
+            t.bookId = bookId;
+            t.currencySymbol = TallyApi.currencySymbolOf(bill.currencyCode);
+            t.currencyCode = TallyApi.normalizeCurrencyCode(bill.currencyCode);
+            t.tags = bill.tags == null ? "" : bill.tags.trim();
+            t.fee = bill.fee;
+            t.photoPath = "";
+            t.excludeFromBudget = bill.isExcludedFromBudget();
+            t.note = from.name + " -> " + to.name;
+            t.remark = remark;
+            db.transactionDao().insert(t);
+        });
+        BackupManager.triggerAutoUploadIfEnabled(app);
+        com.example.budgetapp.widget.WidgetUtils.updateAllWidgets(app);
+    }
+
+    /**
+     * 按名称查找账户；不存在则创建一个“资产(0)”账户，方便自动化记账开箱即用。
+     */
+    private static int resolveAssetId(AppDatabase db, String name) {
+        if (TextUtils.isEmpty(name)) {
+            return 0;
+        }
+        String target = name.trim();
+        List<AssetAccount> all = db.assetAccountDao().getAllAssetsSync();
+        if (all != null) {
+            for (AssetAccount a : all) {
+                if (a != null && target.equals(a.name) && a.type == 0) {
+                    return a.id;
+                }
+            }
+            for (AssetAccount a : all) {
+                if (a != null && target.equals(a.name)) {
+                    return a.id;
+                }
+            }
+        }
+        AssetAccount created = new AssetAccount(target, 0d, 0);
+        created.updateTime = System.currentTimeMillis();
+        db.assetAccountDao().insert(created);
+        List<AssetAccount> after = db.assetAccountDao().getAllAssetsSync();
+        if (after != null) {
+            for (AssetAccount a : after) {
+                if (a != null && target.equals(a.name) && a.type == 0) {
+                    return a.id;
+                }
+            }
+        }
+        return 0;
+    }
+
+    /** 把新分类补进 Tally 的分类列表，避免账单出现“看不见的分类”。 */
+    private static void ensureCategoryExists(Context app, int type, String category) {
+        try {
+            if (type == TallyApi.TYPE_EXPENSE) {
+                List<String> list = new ArrayList<>(CategoryManager.getExpenseCategories(app));
+                if (!list.contains(category)) {
+                    list.add(category);
+                    CategoryManager.saveExpenseCategories(app, list);
+                }
+            } else if (type == TallyApi.TYPE_INCOME) {
+                List<String> list = new ArrayList<>(CategoryManager.getIncomeCategories(app));
+                if (!list.contains(category)) {
+                    list.add(category);
+                    CategoryManager.saveIncomeCategories(app, list);
+                }
+            }
+        } catch (Exception ignored) {
+            // 分类补录失败不影响记账主流程
+        }
+    }
+
+    // ================= 幂等 =================
+
+    private static boolean isDuplicated(Context app, AppDatabase db, TallyApi.Bill bill) {
+        if (!TextUtils.isEmpty(bill.extId) && hasWritten(app, bill.extId)) {
+            return true;
+        }
+        // 兜底：同类型、同金额、同备注、时间相近（多维度匹配，减少误判）
+        long base = bill.time > 0 ? bill.time : System.currentTimeMillis();
+        List<Transaction> recent = db.transactionDao()
+                .getTransactionsByRange(base - FALLBACK_WINDOW_MS, base + FALLBACK_WINDOW_MS);
+        if (recent != null) {
+            String billRemark = bill.remark == null ? "" : bill.remark.trim();
+            for (Transaction t : recent) {
+                if (t != null && t.type == bill.type
+                        && Math.abs(t.amount - bill.amount) < 0.005d
+                        && TextUtils.equals(t.remark == null ? "" : t.remark.trim(), billRemark)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasWritten(Context app, String extId) {
+        if (TextUtils.isEmpty(extId)) {
+            return false;
+        }
+        SharedPreferences prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        return prefs.getStringSet(KEY_IDS, new LinkedHashSet<>()).contains(extId);
+    }
+
+    private static void markWritten(Context app, String extId) {
+        if (TextUtils.isEmpty(extId)) {
+            return;
+        }
+        SharedPreferences prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        Set<String> ids = new LinkedHashSet<>(prefs.getStringSet(KEY_IDS, new LinkedHashSet<>()));
+        ids.add(extId);
+        // 只保留最近的 MAX_IDS 条，避免无限增长
+        if (ids.size() > MAX_IDS) {
+            List<String> list = new ArrayList<>(ids);
+            ids = new LinkedHashSet<>(list.subList(list.size() - MAX_IDS, list.size()));
+        }
+        prefs.edit().putStringSet(KEY_IDS, ids).apply();
+    }
+
+    // ================= 小工具 =================
+
+    private static void appendRemark(StringBuilder sb, String text) {
+        if (text == null || text.isEmpty()) {
+            return;
+        }
+        if (sb.length() > 0) {
+            sb.append(' ');
+        }
+        sb.append(text);
+    }
+
+    private static String trimNumber(double value) {
+        if (value == Math.floor(value)) {
+            return String.valueOf((long) value);
+        }
+        return String.format(Locale.ROOT, "%.2f", value);
+    }
+}
