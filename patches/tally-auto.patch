+package com.example.budgetapp.api;
+
+import android.app.Activity;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.Toast;
+
+/**
+ * 外部记账接口入口（无界面）。
+ *
+ * <p>由自动化工具（如 AutoAccounting）通过 {@code tally://publicapi/addbill?...} 调起，
+ * 写入完成后自动结束；{@code showresult=0} 时完全静默。</p>
+ *
+ * <p>此 Activity 不展示任何界面（透明主题、不进最近任务），只负责解析参数并交给
+ * {@link TallyApiWriter} 写库。写入在后台线程执行，本 Activity 会等待回调再结束，
+ * 以确保进程不会在写库完成前被回收。</p>
+ */
+public class TallyApiActivity extends Activity {
+
+    /** 最长等待写入结果的时间，避免异常情况下界面残留 */
+    private static final long WRITE_TIMEOUT_MS = 10_000L;
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private boolean finished = false;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Uri data = getIntent() != null ? getIntent().getData() : null;
+        if (data == null) {
+            finish();
+            return;
+        }
+
+        final TallyApi.Bill bill;
+        try {
+            bill = TallyApi.parse(data);
+        } catch (TallyApi.ParseException e) {
+            toast("Tally 记账参数错误：" + e.getMessage());
+            finish();
+            return;
+        } catch (Exception e) {
+            toast("Tally 记账失败：" + e.getMessage());
+            finish();
+            return;
+        }
+
+        // 安全网：即使写库回调异常丢失，也不会留下透明界面
+        handler.postDelayed(this::finishOnce, WRITE_TIMEOUT_MS);
+
+        TallyApiWriter.write(this, bill, (ok, duplicated, message) -> {
+            if (bill.showResult) {
+                toast(message);
+            }
+            finishOnce();
+        });
+    }
+
+    @Override
+    protected void onDestroy() {
+        handler.removeCallbacksAndMessages(null);
+        super.onDestroy();
+    }
+
+    private void finishOnce() {
+        if (!finished) {
+            finished = true;
+            finish();
+        }
+    }
+
+    private void toast(String message) {
+        try {
+            Toast.makeText(getApplicationContext(), message, Toast.LENGTH_SHORT).show();
+        } catch (Exception ignored) {
+            // 后台弹 Toast 在部分 ROM 上会失败，忽略
+        }
+    }
+}
